#!/usr/bin/env bash
# with-secrets — run one command with op:// references in an env file resolved.
#
#   with-secrets bun run start                     # resolves ./.env
#   with-secrets --env-file path/to/file -- cmd     # resolves an explicit file
#
# The env file holds op:// references, not values, so reading it by accident
# costs nothing — which is the entire point. Resolved values exist only inside
# the child process, for the life of that command.
#
# Named for intent, not backend: call sites and project docs say `with-secrets`,
# so the authentication underneath can change per machine without any of them
# moving.
#
# Defends against accidental exposure, not against someone who already has a
# shell as this user.
set -euo pipefail

usage() {
  echo "usage: with-secrets [--env-file FILE] <command> [args...]" >&2
  exit 2
}

[ $# -gt 0 ] || usage

env_file=".env"
if [ "${1:-}" = "--env-file" ]; then
  [ $# -ge 2 ] || usage
  env_file="$2"
  shift 2
fi
[ "${1:-}" != "--" ] || shift
[ $# -gt 0 ] || usage

if [ ! -f "$env_file" ]; then
  echo "with-secrets: no env file at '$env_file' — pass --env-file to point elsewhere" >&2
  exit 4
fi

# Two authentication paths, chosen by what the machine has.
#
# A headless box cannot authenticate interactively, so it carries a service
# account token and goes through op-sa. A laptop running the 1Password desktop
# app authenticates through it — biometric, no long-lived token on disk — so
# plain `op` is both simpler and strictly safer there. Never give a machine a
# service account token when it can already authenticate as you.
#
# op run masks resolved values in the child's output by default; left enabled.
if [ -r "${OP_SA_TOKEN_FILE:-$HOME/.config/op-sa/token}" ]; then
  exec op-sa run --env-file="$env_file" -- "$@"
fi
exec op run --env-file="$env_file" -- "$@"
