# Identity for the edloidas account (macOS). Linked to ~/.gitconfig.local by install.sh.
[user]
	name = Mikita Taukachou
	email = edloidas@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKuJFvESPW+08kC2OQcTx9GZ1jnSwIKSLK4bFiU9D7f6
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
	editor = zed --wait
